    {
      "command": "llamafactory-cli train configs/training/generator_sft_qwen32b_lora.yaml && python -m ttc_dense_verifier.cli export-training-summary --config configs/training/generator_sft_qwen32b_lora.yaml --output outputs/logs/generator_sft_metrics_${TTC_RUN_ID}.json --label generator_sft",
