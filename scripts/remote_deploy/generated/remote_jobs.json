      "command": "python -m ttc_dense_verifier.cli export-evaluation-assets --input outputs/demo_cases/ttc_beam_outputs.jsonl --output-dir outputs/tables/beam_eval --judge-model \"${JUDGE_MODEL:-remote-judge-model}\"",
