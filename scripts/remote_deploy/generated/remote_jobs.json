    {
      "command": "python -m ttc_dense_verifier.cli build-generation-requests --questions data/raw_questions/questions.jsonl --mode negative --model \"${GENERATOR_MODEL:-Qwen2.5-32B-Instruct}\" --output data/generated_negative/negative_generation_requests.jsonl",
      "config_path": "configs/data_generation/negative_generation.yaml",
