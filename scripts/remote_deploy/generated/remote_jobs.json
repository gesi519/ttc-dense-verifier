      "command": "python -m ttc_dense_verifier.cli validate-verifier-scores --input outputs/logs/verifier_validation_scores_${TTC_RUN_ID}.jsonl --output outputs/logs/verifier_score_validation_${TTC_RUN_ID}.json --min-pairwise-accuracy \"${MIN_VERIFIER_PAIRWISE_ACCURACY:-0.65}\"",
      "config_path": "configs/training/verifier_rm_qwen7b.yaml",
      "execution_scope": "remote-only",
      "log_path": "/srv/ttc-dense-verifier/outputs/logs/verifier_score_validation_${TTC_RUN_ID}.log",
      "name": "verifier_score_validation",
